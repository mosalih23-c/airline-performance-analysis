	partition airline_performance = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("D:\data analysis project\airline-performance-analysis\results\airline_performance.csv"),[Delimiter=",", Columns=12, Encoding=1252, QuoteStyle=QuoteStyle.None]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers",{{"AIRLINE", type text}, {"AIRLINE_NAME", type text}, {"Total_Flights", Int64.Type}, {"Cancelled_Flights", Int64.Type}, {"Diverted_Flights", Int64.Type}, {"Delayed_Departures", Int64.Type}, {"Delayed_Arrivals", Int64.Type}, {"Avg_Departure_Delay", type number}, {"Avg_Arrival_Delay", type number}, {"Cancellation_Rate", type number}, {"Departure_Delay_Rate", type number}, {"Arrival_Delay_Rate", type number}})
				in
				    #"Changed Type"

	annotation PBI_ResultType = Table

