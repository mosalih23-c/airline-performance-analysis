table airline_performance
	lineageTag: dc41078a-9169-488f-a024-5f384c271a4b

	measure 'Total Flights' =
			
			COUNTROWS(fact_flights)
		formatString: 0
		lineageTag: e3af1379-3d65-41c9-9546-82b9104bc435

	measure 'Cancelled Flights' =
			
			CALCULATE(
			    COUNTROWS(fact_flights),
			    fact_flights[IS_CANCELLED] = 1
			)
		formatString: 0
		lineageTag: 022f938e-9776-49ff-b479-65fafc59f0db

	measure 'Cancellation Rate' =
			
			DIVIDE(
			    [Cancelled Flights],
			    [Total Flights]
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 609aa024-441e-4233-802d-d24bee726c2b

	measure 'Arrival Dela Rate' =
			
			DIVIDE(
			    CALCULATE(
			        COUNTROWS(fact_flights),
			        fact_flights[IS_ARRIVAL_DELAYED] = 1
			    ),
			    [Total Flights]
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: f3f4b0de-3b91-4461-af21-3f2d6f00d78c

	measure 'Average Arrival Delay' =
			
			AVERAGE(fact_flights[ARRIVAL_DELAY])
		lineageTag: 0a3a047b-20b4-44b1-b2d1-2901283a691c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average Departure Delay' =
			
			AVERAGE(fact_flights[DEPARTURE_DELAY])
		lineageTag: 091bdd17-2198-450a-ba8e-aa547b3a840e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column AIRLINE
		dataType: string
		lineageTag: 5e087b2e-b88b-408f-9daf-436b373971d6
		summarizeBy: none
		sourceColumn: AIRLINE

		annotation SummarizationSetBy = Automatic

	column AIRLINE_NAME
		dataType: string
		lineageTag: 865c6c43-862b-48f1-9d9f-dc642be3ecd4
		summarizeBy: none
		sourceColumn: AIRLINE_NAME

		annotation SummarizationSetBy = Automatic

	column Total_Flights
		dataType: int64
		formatString: 0
		lineageTag: 9762ad31-e063-42c1-b7b2-38f830930dc2
		summarizeBy: sum
		sourceColumn: Total_Flights

		annotation SummarizationSetBy = Automatic

	column Cancelled_Flights
